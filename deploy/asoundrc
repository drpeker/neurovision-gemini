# NeuroVision: INMP441 I2S mikrofon (adau7002-simple overlay, kart adi "inmp441")
# Zincir: hw (2 kanal S32) -> dsnoop (paylasimli) -> sol kanal -> yazilim kazanci -> plug

pcm.inmp441_snoop {
    type dsnoop
    ipc_key 441441
    ipc_perm 0666
    slave {
        pcm "hw:inmp441,0"
        channels 2
        format S32_LE
        rate 48000
        period_size 960
        buffer_size 3840
    }
}

# INMP441 L/R pini GND'de oldugu icin ses sol kanalda
pcm.inmp441_left {
    type route
    slave { pcm "inmp441_snoop"; channels 2 }
    ttable.0.0 1
}

pcm.inmp441_boost {
    type softvol
    slave.pcm "inmp441_left"
    control { name "Mic Boost"; card inmp441 }
    min_dB -10.0
    max_dB 30.0
    resolution 41
}

pcm.mic {
    type plug
    slave.pcm "inmp441_boost"
    hint { show on; description "NeuroVision INMP441 mic" }
}

# 3.5 mm jak: plug her ornekleme hizini/kanal sayisini jaka uygun hale getirir
pcm.speaker {
    type plug
    slave.pcm "hw:Headphones,0"
    hint { show on; description "NeuroVision 3.5 mm hoparlor" }
}
